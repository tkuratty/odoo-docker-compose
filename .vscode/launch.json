{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Odoo: Run",
      "type": "debugpy",
      "request": "launch",
      "program": "/usr/bin/odoo",
      "args": [
        "--config=/etc/odoo/odoo.conf",
        "--dev=all"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Odoo: Run with Debug",
      "type": "debugpy",
      "request": "launch",
      "program": "/usr/bin/odoo",
      "args": [
        "--config=/etc/odoo/odoo.conf",
        "--dev=all",
        "--debug"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Odoo: Attach to Running Container",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/workspace"
        }
      ],
      "justMyCode": false
    }
  ]
}
